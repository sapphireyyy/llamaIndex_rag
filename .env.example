RAG_ENVIRONMENT=development
RAG_DATABASE_URL=sqlite+aiosqlite:///./enterprise_rag.db
RAG_OBJECT_STORE_BACKEND=filesystem
RAG_OBJECT_STORE_ROOT=./var/objects
RAG_QUEUE_BACKEND=inprocess
RAG_VECTOR_BACKEND=qdrant
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=enterprise-rag-chunks
RAG_LEXICAL_BACKEND=memory
RAG_MODEL_BACKEND=extractive
# 配置为远端模型时，使用 openai_compatible 并填写下列三项。
# 例如 DeepSeek：RAG_MODEL_API_BASE=https://api.deepseek.com/v1
# RAG_MODEL_BACKEND=openai_compatible
# RAG_MODEL_API_BASE=
# RAG_MODEL_NAME=
# RAG_MODEL_API_KEY_REFERENCE=env://OPENAI_API_KEY
# OPENAI_API_KEY=
RAG_OIDC_ENABLED=false
RAG_OIDC_ISSUER=
RAG_OIDC_AUDIENCE=enterprise-rag
RAG_OIDC_JWKS_URL=
RAG_DEV_AUTH_ENABLED=true
RAG_DEV_TENANT_ID=tenant-demo
RAG_DEV_USER_ID=admin-demo
RAG_DEV_GROUPS=administrators
RAG_ALLOWED_ORIGINS=http://localhost:5173
RAG_MAX_UPLOAD_BYTES=26214400
RAG_ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.md,.txt,.html
RAG_CONTENT_CAPTURE_ENABLED=false
RAG_LOG_LEVEL=INFO
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
