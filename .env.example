RAG_ENVIRONMENT=development
RAG_DATABASE_URL=sqlite+aiosqlite:///./enterprise_rag.db
RAG_OBJECT_STORE_BACKEND=filesystem
RAG_OBJECT_STORE_ROOT=./var/objects
RAG_QUEUE_BACKEND=inprocess
# PostgreSQL workers poll each tenant in an explicit RLS context.
# RAG_WORKER_TENANT_IDS=tenant-demo
# Production: keep migration and runtime URLs in separate secret scopes; do not put migration
# credentials in API or Worker containers.
# RAG_DATABASE_RUNTIME_ROLE=enterprise_rag_app
# RAG_MIGRATION_DATABASE_URL=postgresql+asyncpg://<migration-secret>@<host>/<database>
# RAG_RUNTIME_DATABASE_URL=postgresql+asyncpg://<runtime-secret>@<host>/<database>
# POSTGRES_MIGRATION_PASSWORD_FILE=C:/secure/postgres/migration-password
# POSTGRES_RUNTIME_PASSWORD_FILE=C:/secure/postgres/runtime-password
# RAG_INGESTION_EXECUTION_MODE=queued
# RAG_QUEUE_BACKEND=rabbitmq
# RAG_INDEX_GENERATION_RETENTION_SECONDS=604800
RAG_VECTOR_BACKEND=milvus
RAG_MILVUS_URL=http://localhost:19530
RAG_MILVUS_COLLECTION=enterprise_rag_chunks
# Optional Milvus token reference, for example env://MILVUS_TOKEN
# RAG_MILVUS_TOKEN_REFERENCE=env://MILVUS_TOKEN
RAG_LEXICAL_BACKEND=memory
RAG_MODEL_BACKEND=extractive
# 配置为远端模型时，使用 openai_compatible 并填写下列三项。
# 例如 DeepSeek：RAG_MODEL_API_BASE=https://api.deepseek.com/v1
# RAG_MODEL_BACKEND=openai_compatible
# RAG_MODEL_API_BASE=
# RAG_MODEL_NAME=
# RAG_MODEL_API_KEY_REFERENCE=env://OPENAI_API_KEY
# OPENAI_API_KEY=
RAG_OIDC_ENABLED=false
RAG_OIDC_ISSUER=
RAG_OIDC_AUDIENCE=enterprise-rag
RAG_OIDC_JWKS_URL=
RAG_DEV_AUTH_ENABLED=true
RAG_DEV_TENANT_ID=tenant-demo
RAG_DEV_USER_ID=admin-demo
RAG_DEV_GROUPS=administrators
RAG_ALLOWED_ORIGINS=http://localhost:5173
RAG_MAX_UPLOAD_BYTES=26214400
RAG_ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.md,.txt,.html
RAG_CONTENT_CAPTURE_ENABLED=false
RAG_LOG_LEVEL=INFO
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000

# Web 公开认证配置；这些值会暴露给浏览器，禁止填写客户端密钥、密码或 Token。
WEB_APP_ENVIRONMENT=development
WEB_AUTH_MODE=development
# 使用 OIDC 时显式设置以下公开值。Vite 开发地址为 http://localhost:5173。
# WEB_OIDC_URL=http://localhost:8080
# WEB_OIDC_REALM=enterprise-rag
# WEB_OIDC_CLIENT_ID=enterprise-rag
# WEB_OIDC_REDIRECT_URI=http://localhost:5173/
# WEB_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
# WEB_OIDC_SILENT_CHECK_SSO_REDIRECT_URI=http://localhost:5173/silent-check-sso.html
WEB_OIDC_SCOPES=profile,email
WEB_OIDC_MIN_VALIDITY_SECONDS=30
