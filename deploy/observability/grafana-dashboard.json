{
  "title": "Enterprise RAG Operations",
  "uid": "enterprise-rag-ops",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "API requests and errors", "targets": [{"expr": "sum by (status) (rate(enterprise_rag_requests_total[5m]))"}]},
    {"id": 2, "type": "timeseries", "title": "API p95 latency", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(enterprise_rag_request_duration_seconds_bucket[5m])))"}]},
    {"id": 3, "type": "timeseries", "title": "Query terminal outcomes", "targets": [{"expr": "sum by (status) (rate(enterprise_rag_query_outcomes_total[5m]))"}]},
    {"id": 4, "type": "timeseries", "title": "Ingestion outcomes", "targets": [{"expr": "sum by (status) (rate(enterprise_rag_ingestion_outcomes_total[10m]))"}]},
    {"id": 5, "type": "stat", "title": "Queue backlog", "targets": [{"expr": "enterprise_rag_queue_backlog"}]},
    {"id": 6, "type": "timeseries", "title": "Provider tokens", "targets": [{"expr": "sum by (provider, direction) (rate(enterprise_rag_provider_tokens_total[5m]))"}]},
    {"id": 7, "type": "timeseries", "title": "Provider cost", "targets": [{"expr": "sum by (provider) (increase(enterprise_rag_provider_cost_total[1h]))"}]},
    {"id": 8, "type": "table", "title": "Structural telemetry and revocation backlog", "targets": [{"expr": "enterprise_rag_queue_backlog"}]}
  ]
}
