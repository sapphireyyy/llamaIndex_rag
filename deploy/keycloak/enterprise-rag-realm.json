{
  "realm": "enterprise-rag",
  "enabled": true,
  "displayName": "Enterprise RAG local acceptance",
  "accessTokenLifespan": 60,
  "roles": {
    "realm": [
      {"name": "platform_administrator"},
      {"name": "administrator"},
      {"name": "editor"},
      {"name": "reader"},
      {"name": "quality"},
      {"name": "operator"}
    ]
  },
  "groups": [
    {"name": "platform-administrators", "realmRoles": ["platform_administrator"]},
    {"name": "tenant-alpha-administrators"},
    {"name": "tenant-alpha-employees"},
    {"name": "tenant-beta-readers"}
  ],
  "clients": [
    {
      "clientId": "enterprise-rag",
      "name": "Enterprise RAG local client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/",
        "http://localhost:3000/silent-check-sso.html",
        "http://localhost:5173/",
        "http://localhost:5173/silent-check-sso.html"
      ],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/##http://localhost:5173/"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "enterprise-rag-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "enterprise-rag",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant-id-from-user",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "user.attribute": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "username": "rag-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "rag-admin@example.invalid",
      "firstName": "RAG",
      "lastName": "Administrator",
      "requiredActions": [],
      "credentials": [
        {"type": "password", "value": "rag-admin-dev", "temporary": false}
      ],
      "attributes": {"tenant_id": ["tenant-alpha"]},
      "realmRoles": ["platform_administrator"],
      "groups": ["/platform-administrators", "/tenant-alpha-administrators"]
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "username": "tenant-alpha-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "tenant-alpha-admin@example.invalid",
      "firstName": "Alpha",
      "lastName": "Administrator",
      "requiredActions": [],
      "credentials": [
        {"type": "password", "value": "tenant-alpha-admin-dev", "temporary": false}
      ],
      "attributes": {"tenant_id": ["tenant-alpha"]},
      "groups": ["/tenant-alpha-administrators", "/tenant-alpha-employees"]
    },
    {
      "id": "00000000-0000-0000-0000-000000000003",
      "username": "tenant-beta-reader",
      "enabled": true,
      "emailVerified": true,
      "email": "tenant-beta-reader@example.invalid",
      "firstName": "Beta",
      "lastName": "Reader",
      "requiredActions": [],
      "credentials": [
        {"type": "password", "value": "tenant-beta-reader-dev", "temporary": false}
      ],
      "attributes": {"tenant_id": ["tenant-beta"]},
      "groups": ["/tenant-beta-readers"]
    }
  ]
}
