FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_CACHE_DIR=/tmp/uv-cache
WORKDIR /app
RUN pip install --no-cache-dir uv==0.8.15
COPY pyproject.toml uv.lock README.md ./
COPY backend ./backend
COPY alembic.ini ./alembic.ini
COPY alembic ./alembic
RUN uv sync --frozen --no-dev --all-extras
RUN chown -R 65532:65532 /tmp/uv-cache
USER 65532:65532
EXPOSE 8000
CMD [".venv/bin/uvicorn", "enterprise_rag.main:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
